{
  "table": "merchants",
  "module": "economy",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string"
    },
    "region_bp": {
      "type": "int",
      "min": 0,
      "max": 20000,
      "required": true
    },
    "daily_limit": {
      "type": "int",
      "min": 0,
      "required": true
    },
    "note": {
      "type": "string"
    }
  }
}
