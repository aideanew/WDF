{
  "table": "items",
  "module": "inventory",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "string",
      "required": true,
      "pattern": "^item_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enum",
      "values": [
        "raw",
        "material",
        "tool",
        "food",
        "facility",
        "building",
        "chest",
        "lock",
        "equipment",
        "misc"
      ],
      "required": true
    },
    "base_price": {
      "type": "int",
      "min": 0,
      "required": true
    },
    "weight": {
      "type": "int",
      "min": 0,
      "required": false,
      "note": "总表未给，留空待补（E-06 决策：文档缺字段放松为可选）"
    },
    "capacity": {
      "type": "int",
      "min": 0
    },
    "stack": {
      "type": "int",
      "min": 1
    },
    "craftable": {
      "type": "bool"
    },
    "unlock_level": {
      "type": "int",
      "min": 0,
      "max": 49,
      "note": "min 改 0（D-07 裁决：全 106 行 unlock_level=0）"
    }
  }
}
