{
  "table": "recipes",
  "module": "crafting",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "string",
      "required": true
    },
    "output": {
      "type": "string",
      "required": true,
      "ref": "items.id"
    },
    "output_count": {
      "type": "int",
      "min": 1,
      "required": true
    },
    "inputs": {
      "type": "string",
      "required": true,
      "note": "itemId*数量;itemId*数量"
    },
    "station": {
      "type": "string"
    },
    "job": {
      "type": "string",
      "ref": "jobs.id"
    },
    "unlock_level": {
      "type": "int",
      "min": 0,
      "max": 49,
      "note": "min 改 0（D-10 裁决：全 80 行 unlock_level=0）"
    }
  }
}
