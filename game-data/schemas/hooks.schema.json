{
  "table": "hooks",
  "module": "hook",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string"
    },
    "target_dist": {
      "type": "int",
      "min": 0,
      "required": true
    },
    "angle_deg": {
      "type": "int",
      "min": 0,
      "max": 360,
      "required": true
    },
    "max_power_bp": {
      "type": "int",
      "min": 0,
      "required": true
    },
    "note": {
      "type": "string"
    }
  }
}
