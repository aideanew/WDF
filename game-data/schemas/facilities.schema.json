{
  "table": "facilities",
  "module": "raft",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string"
    },
    "effect_bp": {
      "type": "int",
      "min": 0,
      "max": 10000
    },
    "station": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
