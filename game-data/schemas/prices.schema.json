{
  "table": "prices",
  "module": "economy",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "string",
      "required": true,
      "ref": "items.id"
    },
    "base_price": {
      "type": "int",
      "min": 0,
      "required": true
    },
    "recycle_bp": {
      "type": "int",
      "min": 0,
      "max": 100000,
      "note": "原上限 10000 与总表回收价（金锭/古董等最高 15000）冲突，已放宽（E-06）"
    }
  }
}
