{
  "table": "chests",
  "module": "chest",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "string",
      "required": true
    },
    "material": {
      "type": "enum",
      "values": [
        "wood",
        "copper",
        "iron"
      ],
      "required": true
    },
    "lock": {
      "type": "string",
      "required": true,
      "ref": "locks.id"
    },
    "smashable": {
      "type": "bool",
      "required": false,
      "note": "材质决定（PD7-09 修正 D-09 全 true）：wood=true/copper=false/iron=false（§3.6:250 木箱可砸、§3.6:260 铜/铁箱砸不开只能开锁）"
    },
    "size": {
      "type": "int",
      "min": 1,
      "note": "D-09 裁决值：全 3 行 size=1（原 enum 改 int）"
    },
    "item_id": {
      "type": "string",
      "required": true,
      "ref": "items.id",
      "note": "D-19 裁决值：对齐背包物品 id"
    }
  }
}
