{
  "table": "chests",
  "module": "chest",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "string",
      "required": true
    },
    "material": {
      "type": "enum",
      "values": [
        "wood",
        "copper",
        "iron"
      ],
      "required": true
    },
    "lock": {
      "type": "string",
      "required": true,
      "ref": "locks.id"
    },
    "smashable": {
      "type": "bool",
      "required": false,
      "note": "总表未明确每箱可否砸，留空待补"
    },
    "size": {
      "type": "enum",
      "values": [
        "small",
        "medium",
        "large",
        "huge"
      ]
    }
  }
}
