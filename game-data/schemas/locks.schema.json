{
  "table": "locks",
  "module": "chest",
  "primaryKey": "id",
  "status": "active",
  "fields": {
    "id": {
      "type": "enum",
      "values": [
        "none",
        "iron",
        "copper",
        "silver",
        "gold"
      ],
      "required": true
    },
    "hits_required": {
      "type": "int",
      "min": 0,
      "max": 4,
      "required": false,
      "note": "总表未给开锁次数，留空待补"
    },
    "zone_bp": {
      "type": "int",
      "min": 0,
      "max": 10000,
      "required": false,
      "note": "总表未给分区价值，留空待补"
    },
    "drop_group": {
      "type": "string"
    }
  }
}
